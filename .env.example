# ==========================================================
# Shopify Bosta Integration Engine Environment Variables
# ==========================================================

# Node Environment & Port
NODE_ENV=production
PORT=3000

# Bosta API Credentials
# Get your API key from Bosta Merchant Dashboard -> Settings -> API Keys
BOSTA_API_KEY=bosta_live_xxxxxxxxxxxxxxxxxxxxxxxx
BOSTA_ENV=live  # 'live' or 'sandbox'

# Shopify Store Credentials
# Get Admin Access Token from Shopify Admin -> Settings -> Apps -> Develop Apps
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxx

# Daily Background Sync Schedule (Hour in 24h format: e.g. 00 for midnight)
CRON_SCHEDULE_HOUR=00
CRON_SCHEDULE_MINUTE=00

# Automated Sync Actions
AUTO_TAG_ORDERS=true
AUTO_MARK_PAID=true
AUTO_FULFILL_DELIVERED=true
